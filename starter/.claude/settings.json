{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "inherit"
  },
  "disableBypassPermissionsMode": "disable",
  "enableAllProjectMcpServers": false,
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Bash(op read *)",
      "Bash(op item get *--reveal*)",
      "PowerShell(op read *)",
      "PowerShell(op item get *--reveal*)"
    ]
  }
}
